# Copy to .env.local (or run `npm run setup`, which creates it with strong values).
# Restart the server after changing anything here.

# --- Admin panel (required in production) ---
# At least 10 characters. A production server refuses to log anyone in without it.
ADMIN_PASSWORD=
# Random string of at least 32 characters; signs the admin session cookie.
AUTH_SECRET=
# Optional two-factor login: base32 secret shared with an authenticator app. When
# set, login asks for the app's 6-digit code after the password. Create it with
# `npm run setup -- --totp` (prints a QR code to scan); `--no-totp` removes it.
# ADMIN_TOTP_SECRET=

# --- Site ---
# Public address, used for the sitemap and share previews.
SITE_URL=https://syyhoaxanalyzer.com

# --- Database ---
# SQLite file holding articles, reports and statistics. Defaults to data/hoax.db.
# DATABASE_PATH=/var/lib/hoax-analyzer/hoax.db
# Daily backups go to data/backup/ (the last 14 are kept). Set to 0 to turn them off.
# DB_BACKUP_KEEP=14

# --- Detection model ---
# The site's own classifier is trained with `npm run train:baseline` (or from the
# admin Model page) and needs no setting. Optionally, an external model over HTTP
# can answer instead: it must accept POST { text, lang } and return the
# DetectionResult shape from src/lib/detect.ts.
# MODEL_API_URL=http://127.0.0.1:8000/detect
# Sent as "Authorization: Bearer <key>" when set.
# MODEL_API_KEY=
# Give up on the external model after this many milliseconds and let the local classifier answer.
# MODEL_TIMEOUT_MS=15000

# --- Notifications for new reports (optional) ---
# Telegram: create a bot with @BotFather, then send it a message and read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# E-mail over SMTP (for Gmail use an app password, not the account password).
# SMTP_URL=smtps://user%40gmail.com:app-password@smtp.gmail.com:465
# REPORT_NOTIFY_EMAIL=syyhoaxanalyzer@gmail.com

# --- Research log (see /privacy and /admin/research) ---
# Days to keep visitors' IP addresses; the network name, country and a keyed hash stay.
# 0 = keep them. The hash is keyed with AUTH_SECRET, so keep that stable.
# RESEARCH_IP_RETENTION_DAYS=365
