# Copy to .env.local and fill in to connect a real detection backend.
#
# Streamlit Community Cloud (rag-fusion.streamlit.app) does NOT expose a REST
# API. Put an HTTP endpoint in front of the same RAG pipeline (FastAPI/Flask),
# then point this at it. It must accept POST { text, lang } and return the
# DetectionResult shape from src/lib/detect.ts.
#
# When unset, the app runs the transparent local heuristic stub (demo mode).

# RAG_FUSION_API_URL=https://your-rag-endpoint.example.com/detect

# --- Database ---
# SQLite file holding articles and reports. Defaults to data/hoax.db in the
# project folder; back this file up.
# DATABASE_PATH=/var/lib/hoax-analyzer/hoax.db

# --- Admin panel ---
# Password to log into /admin. CHANGE THIS in production.
ADMIN_PASSWORD=admin123
# Secret used to sign the admin session cookie. Set a long random value in production.
AUTH_SECRET=change-me-to-a-long-random-string
