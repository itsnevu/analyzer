{
  "name": "syy-hoax-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Hoax Detection & Analyzer — Next.js redesign (dark neumorphism)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "import:legacy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-legacy.ts",
    "import:panel": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-legacy-panel.ts",
    "fetch:archived": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-archived.ts",
    "apply:archived": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/apply-archived.ts",
    "setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/setup-env.ts",
    "prepare:ocr": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prepare-ocr.ts",
    "predev": "npm run -s prepare:ocr && npm run -s prepare:ipdb",
    "prebuild": "npm run -s prepare:ocr && npm run -s prepare:ipdb",
    "db:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup-db.ts",
    "test": "vitest run",
    "prepare:ipdb": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prepare-ipdb.ts",
    "import:usage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-legacy-usage.ts",
    "train:baseline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/train-baseline.ts",
    "fetch:commoncrawl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-commoncrawl.ts",
    "apply:commoncrawl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/apply-commoncrawl.ts"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "^16.3.8",
    "nodemailer": "^10.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
